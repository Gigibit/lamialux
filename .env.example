DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Storytel API (see https://github.com/MauritsWilke/storytel-api)
STORYTEL_BASE_URL=https://www.storytel.com
STORYTEL_SEARCH_PATH=/api/search
STORYTEL_API_KEY=
STORYTEL_MARKET=us
STORYTEL_TIMEOUT_SECONDS=15

# Daydream Canvas API (see https://app.daydream.live/)
DAYDREAM_BASE_URL=https://app.daydream.live
DAYDREAM_CANVAS_STREAM_PATH=/api/canvas/streams
DAYDREAM_PROMPT_UPDATE_PATH_TEMPLATE=/api/canvas/streams/{session_id}/prompt
DAYDREAM_API_KEY=
DAYDREAM_ENGINE=stable-diffusion
DAYDREAM_TIMEOUT_SECONDS=30

# Narrative mode provider
NARRATIVE_MODE_PROVIDER=THIRDY_PARTS_STORYTEL
WEB_RESEARCH_SEARCH_URL=https://duckduckgo.com/html/
WEB_RESEARCH_TIMEOUT_SECONDS=20
WEB_RESEARCH_CHUNK_SIZE=650
WEB_RESEARCH_SQLITE_PATH=storage/web_research_chunks.sqlite3
WEB_RESEARCH_TTS_AUDIO_STREAM_URL=https://www.soundhelix.com/examples/mp3/SoundHelix-Song-1.mp3

